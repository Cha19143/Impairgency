# Firebase
.firebase/
firebase-debug.log
functions/node_modules/
# Firebase client config is committed on purpose. These values are public
# identifiers, not secrets - Google documents them as such, and security comes
# from firestore.rules, which are in this repo and tested. Ignoring them would
# mean every teammate had to run `flutterfire configure` before they could
# build, and CI could not build at all.
#
# If this repo is ever made public, restrict the browser API key in the Google
# Cloud console first.

# Node
node_modules/

# Playwright
test/e2e/test-results/
test/e2e/playwright-report/

# MiDaS v2.1 small for the depth device check (66 MB, MIT). Not committed:
# see docs/VISION.md, "Depth".
assets/models/model_opt.tflite

# tool/build_depth_check.sh puts it back when the build ends.
pubspec.yaml.depth-check-backup
