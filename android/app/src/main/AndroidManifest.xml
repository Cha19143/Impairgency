<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Location. Foreground only: §2.A.4 sharing, §2.A.5 the SOS location leg,
         §3.1 guardian tracking. Background location is deliberately not
         requested - it needs a Play Store justification the project does not
         have, and nothing in scope needs a fix while the app is closed. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- §3.2 guardian SOS alerts. Android 13+ requires this at runtime, and a
         guardian who never granted it is a guardian who is never told. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- §2.A.1 and §2.A.3, the camera and detection loop. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- §2.C voice commands. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- The emergency contact picker. Read only; nothing is written back. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>

    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:label="ImpairGency"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <!-- §3.2 asks alerts to "prioritize emergency delivery". Without a
             declared default channel, FCM notifications land at default
             importance: no sound, no heads-up, easy to miss. The channel
             itself is created at runtime with IMPORTANCE_HIGH. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="impairgency_emergency"/>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Without this, package visibility on API 30+ hides the dialer and
             the SOS call leg silently fails to launch. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
