<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. Saved friends' faces stay on the phone they were
     saved on: not in a cloud backup, not copied to a new phone. See
     lib/data/friend_store_io.dart. Everything else backs up as before. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="faces/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="faces/" />
    </device-transfer>
</data-extraction-rules>
