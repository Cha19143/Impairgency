rules_version = '2';

// ImpairGency Firestore rules.
//
// The previous project had no rules file in version control at all. These exist
// so that the access model is reviewable, testable, and cannot silently expire.
//
// Two principles:
//   1. A guardian sees a user only through an accepted pairing, and only what
//      that user has consented to share.
//   2. Admin is a custom claim set by a Cloud Function. It is never a field the
//      client can write, because a client-writable role field is not a role.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Admin is membership of a collection nothing client-side can write to,
    // rather than a custom claim.
    //
    // Custom claims can only be set with the Admin SDK, which means a Cloud
    // Function, which means a billing account. This gives the same property
    // for free: `admins` is deny-all for every client, so the only way in is
    // the Firebase console or the Admin SDK. Bootstrap the first admin by
    // creating the document by hand.
    //
    // Costs one document read per admin-gated evaluation. `exists()` inside
    // rules is privileged and does not itself go through the rules below.
    function isAdmin() {
      return signedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Pairing documents use a deterministic id so this is one lookup, not a
    // query: {guardianUid}_{viUserId}.
    function isPairedGuardianOf(userId) {
      return signedIn() && exists(
        /databases/$(database)/documents/pairings/$(request.auth.uid + '_' + userId)
      );
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function codeDoc(code) {
      return get(/databases/$(database)/documents/pairing_codes/$(code)).data;
    }

    // A pairing is only legitimate if it points at a code the target user
    // issued and this guardian already redeemed. Without this, guardianId ==
    // request.auth.uid is self-certifying: anyone signed in could write
    // pairings/{ownUid}_{victimId} and become a "paired guardian" of a
    // stranger, with read access to their user document and - once that user
    // grants location consent to someone they actually trust - their location.
    function redeemedCodeFor(code, ownerId) {
      return code is string
             && exists(/databases/$(database)/documents/pairing_codes/$(code))
             && codeDoc(code).ownerId == ownerId
             && codeDoc(code).usedBy == request.auth.uid;
    }

    // A new navigation-history row: one trip, opened as ongoing, with an
    // expiry about 30 days out. The window is wide on purpose — the phone's
    // clock and request.time are not the same instant.
    function navigationEntryCreate() {
      let data = request.resource.data;
      return data.keys().hasAll([
               'destinationName', 'destinationAddress',
               'destinationLat', 'destinationLng',
               'originLat', 'originLng',
               'startedAt', 'endedAt', 'status', 'expiresAt'])
             && data.keys().hasOnly([
               'destinationName', 'destinationAddress',
               'destinationLat', 'destinationLng',
               'originLat', 'originLng',
               'startedAt', 'endedAt', 'status', 'expiresAt'])
             && data.destinationName is string
             && data.destinationName.size() > 0
             && data.destinationName.size() <= 300
             && data.destinationAddress is string
             && data.destinationAddress.size() <= 300
             && data.destinationLat is number
             && data.destinationLat >= -90
             && data.destinationLat <= 90
             && data.destinationLng is number
             && data.destinationLng >= -180
             && data.destinationLng <= 180
             && data.originLat is number
             && data.originLat >= -90
             && data.originLat <= 90
             && data.originLng is number
             && data.originLng >= -180
             && data.originLng <= 180
             && data.status == 'ongoing'
             && data.startedAt == request.time
             && data.endedAt == null
             && data.expiresAt is timestamp
             && data.expiresAt > request.time + duration.value(29, 'd')
             && data.expiresAt < request.time + duration.value(31, 'd');
    }

    // Consent is stored on the user document as a map of booleans. Absent means
    // withheld - never assume consent from a missing field.
    function hasConsent(userId, key) {
      return userDoc(userId).consent[key] == true;
    }

    // An administrator removed this account. Its Firebase sign-in cannot be
    // deleted without a server, so it is marked instead, and everything that
    // account could write, it now cannot.
    function isRemoved(userId) {
      return exists(/databases/$(database)/documents/removed_accounts/$(userId));
    }

    // What an administrator may change on someone's account - the same list as
    // AdminRepository.editableKeys. Not consent: whether someone's location is
    // shared is theirs to decide.
    function adminEditable() {
      return ['name', 'displayName', 'age', 'impairment', 'impairmentDetail',
              'phone', 'deviceId', 'role', 'updatedAt', 'updatedBy'];
    }

    // Fields the client must never set on itself.
    function noPrivilegeEscalation() {
      return !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny(['role', 'admin', 'createdAt']);
    }

    // ---- users ---------------------------------------------------------

    match /users/{userId} {
      allow read: if isOwner(userId)
                  || isAdmin()
                  || isPairedGuardianOf(userId);

      allow create: if isOwner(userId)
                    && !isRemoved(userId)
                    && request.resource.data.role in ['vi', 'guardian']
                    && request.resource.data.uid == userId;

      allow update: if (isOwner(userId)
                        && !isRemoved(userId)
                        && noPrivilegeEscalation())
                    || (isAdmin()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(adminEditable())
                        && request.resource.data.get('role', 'vi')
                             in ['vi', 'guardian']);

      allow delete: if isAdmin();
    }

    // Device tokens for §3.2 guardian alerts. Owner-writable; nothing on the
    // client ever reads someone else's. The Cloud Function that sends the alert
    // uses the Admin SDK and bypasses rules entirely, which is why no read is
    // granted here at all - a token another account can read is a token another
    // account can impersonate a device with.
    match /users/{userId}/push_tokens/{tokenId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && !isRemoved(userId);
    }

    // Saved destinations - home, work, school, and whatever else the user
    // names. Owner only. A guardian is deliberately not given these: where
    // someone *is* is granted by location consent; where they *go* is a
    // different thing to know about a person, and nobody asked for it.
    match /users/{userId}/saved_places/{placeId} {
      // Readable and deletable after removal, so the phone can erase them.
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && !isRemoved(userId);
    }

    // What the app noticed - an obstacle's name, a page's first line, a
    // destination - for the guardian's "recent activity". Its own consent:
    // agreeing to be located is not agreeing to be narrated.
    match /users/{userId}/activity/{eventId} {
      allow read: if isOwner(userId)
                  || isAdmin()
                  || (isPairedGuardianOf(userId) && hasConsent(userId, 'activity'));
      allow create: if isOwner(userId) && hasConsent(userId, 'activity');
      allow update: if false;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Near obstacles the app warned about: type, time, position, distance.
    // The same consent as the activity card. A paired guardian may read.
    // Only the user may write, and only the user may delete — the phone
    // removes rows older than 30 days itself. Nothing here changes the
    // activity rules above.
    match /users/{userId}/obstacle_events/{eventId} {
      allow read: if isOwner(userId)
                  || (isPairedGuardianOf(userId) && hasConsent(userId, 'activity'));
      allow create: if isOwner(userId) && hasConsent(userId, 'activity');
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    // A short notice for the paired guardian: route left, or an hour in
    // one place. The same "Share where I am" consent as live location.
    // Not history. The user writes; only a paired guardian reads.
    // SOS rules above are unchanged.
    match /users/{userId}/guardian_alerts/{alertId} {
      allow read: if isPairedGuardianOf(userId)
                  && hasConsent(userId, 'location');
      allow create: if isOwner(userId)
                    && !isRemoved(userId)
                    && hasConsent(userId, 'location')
                    && request.resource.data.kind is string
                    && request.resource.data.message is string
                    && request.resource.data.at is timestamp;
      allow update: if false;
      allow delete: if false;
    }

    // ---- pairing -------------------------------------------------------

    // A code is written by the user who owns it and redeemed by whoever is
    // given it. Single use, and it expires. Readable by any signed-in account
    // because a guardian must be able to look one up before a link exists.
    match /pairing_codes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();

      allow create: if signedIn()
                    && !isRemoved(request.auth.uid)
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.usedBy == null
                    && request.resource.data.expiresAt > request.time;

      // The only permitted update is a guardian claiming an unused,
      // unexpired code exactly once.
      allow update: if signedIn()
                    && resource.data.usedBy == null
                    && resource.data.expiresAt > request.time
                    && request.resource.data.usedBy == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if (signedIn() && resource.data.ownerId == request.auth.uid)
                    || isAdmin();
    }

    // Deterministic id: {guardianUid}_{viUserId}. Either side can read it,
    // either side can break the link, and only the redeeming guardian can
    // create it.
    match /pairings/{pairingId} {
      allow read: if signedIn()
                  && (resource.data.guardianId == request.auth.uid
                      || resource.data.viUserId == request.auth.uid
                      || isAdmin());

      allow create: if signedIn()
                    && !isRemoved(request.auth.uid)
                    && request.resource.data.guardianId == request.auth.uid
                    && pairingId == request.auth.uid + '_' + request.resource.data.viUserId
                    && redeemedCodeFor(request.resource.data.code,
                                       request.resource.data.viUserId);

      allow delete: if signedIn()
                    && (resource.data.guardianId == request.auth.uid
                        || resource.data.viUserId == request.auth.uid
                        || isAdmin());

      allow update: if false;
    }

    // ---- location history ----------------------------------------------

    // The collection Phase 2 aggregates for environment learning, routine
    // learning, travel recording and the admin dashboard's frequent locations.
    // A guardian reads it only while location consent is switched on, so
    // revoking consent in the app is enforced by the server and not just by
    // hiding a button.
    // Two consents, not one, and they are genuinely different questions.
    //
    //   consent.location  - my guardian may see where I am
    //   consent.history   - the app may remember where I have been
    //
    // Someone may want a guardian able to find them without the app building a
    // record of their life; someone else may want the learning features
    // without anyone watching. Conflating the two would take a decision away
    // from the person it belongs to.
    //
    // Writing is gated server-side rather than only in the app, so revoking
    // `history` actually stops the recording instead of hiding a switch.
    match /location_history/{userId}/fixes/{fixId} {
      allow read: if isOwner(userId)
                  || isAdmin()
                  || (isPairedGuardianOf(userId) && hasConsent(userId, 'location'));

      allow create: if isOwner(userId) && hasConsent(userId, 'history');

      // Append-only. A history that can be edited is not a history.
      allow update: if false;

      // Deletable at any time, consent or not - "what the app has learned"
      // has to be able to forget, and revoking consent must not lock the
      // record in place.
      allow delete: if isOwner(userId) || isAdmin();
    }

    // What the app detected during a session: obstacles, stairs, text read,
    // SOS armed or cancelled. This is the collection the §1.1 review timeline
    // is built from - the substitute for storing video.
    //
    // Owner and admin only. A guardian is deliberately not given it: §3 grants
    // them location and emergency alerts, not a feed of everything the user
    // walked past. An activity feed for guardians would be a separate feature
    // and a separate consent.
    match /location_history/{userId}/events/{eventId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && hasConsent(userId, 'history');
      allow update: if false;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ---- navigation history ------------------------------------------------

    // A trip the user started. The user writes their own rows and reads them.
    // A paired guardian reads, and does not write. Nobody else reads.
    //
    // Not gated on location consent. Sharing where you are right now, and
    // keeping a list of trips you asked the app to guide, are different
    // questions. The pairing is the consent for this list: the guardian was
    // given a code, and the user can break the link.
    //
    // An ongoing row that the phone never closed — the app was killed on the
    // way — stays ongoing here. The guardian's screen shows one older than
    // two hours as cancelled. expiresAt is for the time-to-live policy on
    // this collection group; the phone also deletes its own expired rows.
    match /navigation_history/{userId}/entries/{entryId} {
      allow read: if isOwner(userId) || isPairedGuardianOf(userId);

      allow create: if isOwner(userId)
                    && !isRemoved(userId)
                    && navigationEntryCreate();

      // The only edit is how the trip ended. Coordinates, the destination
      // and the clock it started are fixed at creation.
      allow update: if isOwner(userId)
                    && !isRemoved(userId)
                    && resource.data.status == 'ongoing'
                    && request.resource.data.status in ['completed', 'cancelled']
                    && request.resource.data.endedAt == request.time
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status', 'endedAt']);

      allow delete: if isOwner(userId);
    }

    // ---- SOS -------------------------------------------------------------

    // Written by the user, read by their guardians regardless of location
    // consent: consenting to be tracked is a different question from being
    // told that someone has called for help.
    match /sos_events/{eventId} {
      allow read: if signedIn()
                  && (resource.data.userId == request.auth.uid
                      || isPairedGuardianOf(resource.data.userId)
                      || isAdmin());

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;

      // Legs are appended by the Cloud Function that performs them, and by the
      // owner cancelling or saying "I am okay" after the call. An
      // administrator may mark it resolved - those three fields, nothing
      // else. Nobody moves an emergency onto someone else.
      allow update: if signedIn()
                    && request.resource.data.userId == resource.data.userId
                    && (resource.data.userId == request.auth.uid
                        || (isAdmin()
                            && request.resource.data.diff(resource.data)
                                 .affectedKeys()
                                 .hasOnly(['resolvedAt', 'resolvedBy', 'status'])));
      allow delete: if false;
    }

    // ---- invitations -------------------------------------------------------

    // §1.2 asks administrators to manage accounts. It does not ask them to know
    // anyone's password, and they must not.
    //
    // The dashboard can now add an account directly - through a second Firebase
    // app, so the administrator stays signed in, with a random password nobody
    // sees and a reset email to the person. An invitation is still the other
    // way: the role and any device assignment, keyed by email, for someone who
    // registers themselves.
    //
    // Document id is the lowercased email, so the invitee can find their own.
    // Only once that email is confirmed: anyone can make an account that
    // *claims* an address, and a claim is not enough to read what an
    // administrator wrote for the person who really owns it.
    match /user_invites/{email} {
      allow read: if isAdmin()
                  || (signedIn()
                      && request.auth.token.email != null
                      && request.auth.token.email_verified == true
                      && email == request.auth.token.email.lower());

      allow create, update, delete: if isAdmin();
    }

    // ---- session summaries -------------------------------------------------

    // The aggregate layer administrators read for §1.3, so they never need a
    // collection-group read of everybody's raw coordinates.
    //
    // The no-coordinates property is enforced *here*, not only in the Dart type
    // that writes it. A future client bug that started attaching a position
    // would otherwise quietly turn this into the map of blind people's homes
    // the design went out of its way to avoid.
    match /session_summaries/{summaryId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && hasConsent(request.auth.uid, 'history')
                    && !request.resource.data.keys().hasAny(
                         ['lat', 'lng', 'latitude', 'longitude', 'path', 'fixes']);

      allow update: if false;

      allow delete: if isAdmin()
                    || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // ---- devices -----------------------------------------------------------

    match /devices/{deviceId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.assignedTo == request.auth.uid);
      allow write: if isAdmin();
    }

    // ---- removed accounts --------------------------------------------------

    // Written by an administrator when an account is removed from the
    // dashboard; read by that account's phone, which signs out on seeing it.
    // Never for an administrator - the roster is the Firebase console's.
    match /removed_accounts/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.removedBy == request.auth.uid
                    && !exists(/databases/$(database)/documents/admins/$(userId));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- admin roster ----------------------------------------------------

    // Deny-all from every client. Membership is granted in the Firebase console
    // or with the Admin SDK, never by an app. Readable only by other admins, so
    // the roster is not enumerable by a signed-in stranger.
    match /admins/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- server-only ---------------------------------------------------

    // Email verification is Firebase Auth's own, not a code in a collection.
    // cprwire stored six-digit OTPs in `otp_verification` and mailed them with
    // EmailJS; a database of live login codes is an account takeover waiting to
    // be found, and it needed a Cloud Function to be safe. sendEmailVerification
    // is free, needs no server, and stores nothing. The deny stays as a
    // backstop in case anything ever writes here again.
    match /otp_verification/{document=**} {
      allow read, write: if false;
    }

    match /app_counters/{document=**} {
      allow read, write: if false;
    }

    // ---- event clips ----------------------------------------------------

    // A few seconds around an obstacle, a fall, an SOS, an hour of standing
    // still, or leaving the route. Not the walk. The admin site plays them.
    // The owner can list their own so the phone can delete them after 7 days;
    // a list is a read, and delete-by-query needs it. A guardian cannot.
    // Frames repeat userId so a batched write does not have to read the parent.
    match /event_clips/{clipId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && hasConsent(request.auth.uid, 'recording')
                    && !isRemoved(request.auth.uid)
                    && request.resource.data.triggers is list
                    && request.resource.data.at is timestamp
                    && request.resource.data.endedAt is timestamp
                    && request.resource.data.frameCount is int
                    && request.resource.data.hasFrames is bool
                    && request.resource.data.expiresAt is timestamp;

      allow update: if false;

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      match /frames/{frameId} {
        allow read: if isAdmin()
                    || (signedIn() && resource.data.userId == request.auth.uid);

        allow create: if signedIn()
                      && request.resource.data.userId == request.auth.uid
                      && hasConsent(request.auth.uid, 'recording')
                      && !isRemoved(request.auth.uid)
                      && request.resource.data.i is int
                      && request.resource.data.jpeg is bytes
                      && request.resource.data.jpeg.size() < 200000
                      && request.resource.data.w is int
                      && request.resource.data.h is int;

        allow update: if false;

        allow delete: if signedIn()
                      && resource.data.userId == request.auth.uid;
      }
    }

    // ---- default deny ----------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
